---
import { Image } from "astro:assets";

interface OfferProps {
    title: string;
    icon: string;
}

const { title, icon } = Astro.props;
---

<article>
    <Image src={icon} alt={title} width={74} />
    <h3>{title}</h3>
</article>

<style>
    img {
        display: block;
        width: 74px;
        height: 74px;
        margin: auto;
        opacity: 0.5;
    }
    article {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 200px;
        text-align: center;
        gap: 1rem;
    }
    h2 {
        padding-top: 2rem;
    }
</style>
