---
import { Image } from "astro:assets";

interface OfferProps {
    title: string;
    icon: string;
}

const { title, icon } = Astro.props;
---

<article>
    <Image src={icon} alt={title} width={74} />
    <h3>{title}</h3>
</article>

<style>
    img {
        display: block;
        width: clamp(50px, 10vw, 65px);
        height: clamp(50px, 10vw, 65px);
        opacity: 0.5;
    }
    article {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        width: clamp(100px, 40vw, 200px);
        text-align: center;
        gap: 1rem;
    }
    h3 {
        font-weight: 600;
        padding-top: 2rem;
    }
</style>
