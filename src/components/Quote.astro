---
import { Image } from "astro:assets";
import svg from "../assets/svg/blockquote.svg";
---

<section>
    <Image src={svg} alt="Citát" width={1440} class="quote" />
    <blockquote>
        „The important thing is to catch another branch and keep on swinging.“
    </blockquote>
</section>

<style>
    section {
        position: relative;
        padding: 5rem 0;
    }
    blockquote {
        background-color: var(--orange-color);
        width: 100%;
        font-size: 2rem;
        font-style: italic;
        text-align: center;
        padding: clamp(5rem, 10vw, 10rem) 4rem;
        color: var(--background-color);
        font-weight: 700;
        font-size: 3rem;
    }
    .quote {
        position: absolute;
        bottom: 80%;
        z-index: -1;
    }
</style>
