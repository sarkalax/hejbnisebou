---
import { Image } from "astro:assets";
import svg from "../assets/svg/blockquote.svg";
---

<section>
    <Image src={svg} alt="Citát" width={1440} class="quote" />
    <blockquote>
        „The important thing is to catch another branch and keep on swinging.“
    </blockquote>
</section>

<style>
    section {
        position: relative;
        padding: 5rem 0;
    }
    blockquote {
        width: 100%;
        padding: clamp(3rem, 5vw, 5rem) 4rem;
        font-size: clamp(2rem, 2.4vw, 2.6rem);
        font-style: italic;
        font-weight: 500;
        text-align: center;
        color: var(--orange-color);
    }
    .quote {
        position: absolute;
        bottom: 80%;
        z-index: -1;
    }
</style>
