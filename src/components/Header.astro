---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
---

<header>
    <Logo />
    <nav id="navigation">
        <ul id="links">
            <li>
                <a href="#o-mne"> o mně </a>
            </li>
            <li>
                <a href="#co-nabizim">služby </a>
            </li>
            <li>
                <a href="#cenik"> ceník </a>
            </li>
            <li>
                <a href="#darkove-poukazy"> dárkové poukazy </a>
            </li>
            <li>
                <Button title="Kontakt" />
            </li>
        </ul>
        <ul id="hamburger">
            <li></li>
            <li></li>
            <li></li>
        </ul>
        <Button title="Kontakt" />
    </nav>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const body = document.body;
        const header = document.querySelector("header");
        const navigation = document.getElementById("navigation");
        const hamburger = document.getElementById("hamburger");
        const links = document.querySelectorAll("#links a");

        if (!header || !hamburger || !navigation) {
            return;
        }

        let lastScroll = window.scrollY;
        window.addEventListener("scroll", () => {
            const currentScroll = window.scrollY;
            if (currentScroll > lastScroll) {
                header.style.transform = "translateY(-100%)";
            } else if (currentScroll < lastScroll) {
                header.style.transform = "translateY(0)";
            }
            lastScroll = currentScroll;
        });

        hamburger.addEventListener("click", () => {
            hamburger.classList.toggle("is-open");
            navigation.classList.toggle("is-open");

            if (navigation.classList.contains("is-open")) {
                body.style.overflowY = "hidden";
            } else {
                body.style.overflowY = "auto";
            }
        });
        links.forEach((link) => {
            link.addEventListener("click", () => {
                hamburger.classList.remove("is-open");
                navigation.classList.remove("is-open");
                document.body.style.overflowY = "auto";
            });
        });
    });
</script>

<style>
    header {
        position: fixed;
        top: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 1rem;
        z-index: 999;
        max-width: var(--max-container-width);
        transition: var(--transition);
        background: linear-gradient(
            rgba(26, 26, 26, 0.4) 60%,
            rgba(0, 0, 0, 0)
        );

        @media only screen and (min-width: 960px) {
            padding: 1.8rem 2.5rem;
        }
    }
    button {
        display: none;

        @media only screen and (min-width: 800px) {
            display: block;
        }
    }
    #links {
        display: none;

        @media only screen and (min-width: 800px) {
            display: flex;
            gap: 3rem;
        }
    }
    #navigation.is-open {
        position: absolute;
        inset: 0;
        display: grid;
        justify-content: start;
        align-items: center;
        background: rgba(26, 26, 26, 0.9);
        width: 100vw;
        height: 100vh;
    }
    #navigation.is-open #links {
        display: flex;
        gap: 3rem;
        flex-direction: column;
        padding: 3rem;
    }
    #navigation.is-open #links li {
        font-size: 2rem;
        font-weight: 500;
        color: var(--color-white);
    }
    #navigation li:last-of-type {
        display: block;
        @media only screen and (min-width: 800px) {
            display: none;
        }
    }
    #hamburger {
        display: flex;
        position: absolute;
        top: 0;
        right: 0;
        flex-direction: column;
        z-index: 999;
        margin: 2rem;
        overflow: hidden;
        cursor: pointer;
        z-index: 999;

        @media only screen and (min-width: 800px) {
            display: none;
        }
    }
    #hamburger li {
        display: block;
        width: 3rem;
        height: 0.2rem;
        background: var(--white-color);
        margin: 0.3rem 0;
        transform-origin: 50% 50%;
        transition: var(--transition);
    }
    #hamburger.is-open li:nth-of-type(1) {
        transform: rotate(45deg) translateY(8px) scale(1.3);
    }
    #hamburger.is-open li:nth-of-type(2) {
        transform: translateX(200%);
    }
    #hamburger.is-open li:nth-of-type(3) {
        transform: rotate(-45deg) translateY(-8px) scale(1.3);
    }
</style>
