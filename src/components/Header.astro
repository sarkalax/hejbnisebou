---
import Button from "./Button.astro"
import Logo from "./Logo.astro"
---

<header>
    <a href="#obsah" class="skip-link">Přeskočit na obsah</a>
    <Logo />
    <nav id="navigation" aria-label="Hlavní">
        <ul id="links">
            <li>
                <a href="#o-mne">o mně</a>
            </li>
            <li>
                <a href="#co-nabizim">služby</a>
            </li>
            <li>
                <a href="#cenik">dárkové poukazy</a>
            </li>
            <li>
                <a href="#cenik">ceník</a>
            </li>
            <li>
                <Button href="#kontaktuj-me" title="Kontakt" />
            </li>
        </ul>
        <button
            id="hamburger"
            type="button"
            aria-label="Otevřít menu"
            aria-expanded="false"
            aria-controls="links"
        >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
    </nav>
    <Button href="#kontaktuj-me" title="Kontakt" id="contact-button" />
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const body = document.body
        const header = document.querySelector("header")
        const navigation = document.getElementById("navigation")
        const hamburger = document.getElementById("hamburger")
        const links = document.querySelectorAll("#links a")

        if (!header || !hamburger || !navigation) {
            return
        }

        // Sirka okna se cache-uje a prepisuje az pri resize, aby cteni
        // layoutu uvnitr scroll handleru nevynucovalo reflow.
        let isDesktop = window.innerWidth > 768
        let lastScroll = window.scrollY
        let ticking = false

        const updateHeader = () => {
            ticking = false
            const currentScroll = window.scrollY

            if (!isDesktop) {
                header.style.transform = "translateY(0)"
            } else if (currentScroll < lastScroll || currentScroll === 0) {
                header.style.transform = "translateY(0)"
            } else if (currentScroll > lastScroll) {
                header.style.transform = "translateY(-100%)"
            }
            lastScroll = currentScroll
        }

        window.addEventListener(
            "scroll",
            () => {
                if (ticking) {
                    return
                }
                ticking = true
                requestAnimationFrame(updateHeader)
            },
            { passive: true },
        )

        // Stav menu drzi jedna funkce, aby se aria-expanded nikdy nerozesla
        // s vizualnim stavem.
        const setMenu = (open: boolean) => {
            hamburger.classList.toggle("is-open", open)
            navigation.classList.toggle("is-open", open)
            hamburger.setAttribute("aria-expanded", String(open))
            hamburger.setAttribute(
                "aria-label",
                open ? "Zavřít menu" : "Otevřít menu",
            )
            body.style.overflowY = open ? "hidden" : "auto"
            body.style.height = open ? "100vh" : ""
        }

        window.addEventListener("resize", () => {
            isDesktop = window.innerWidth > 768
            if (isDesktop) {
                setMenu(false)
            }
        })

        hamburger.addEventListener("click", () => {
            setMenu(!navigation.classList.contains("is-open"))
        })

        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                navigation.classList.contains("is-open")
            ) {
                setMenu(false)
                hamburger.focus()
            }
        })

        links.forEach((link) => {
            link.addEventListener("click", () => {
                setMenu(false)
            })
        })
    })
</script>

<style>
    .skip-link {
        position: absolute;
        top: 1rem;
        left: 1rem;
        z-index: 1000;
        padding: 1rem 1.5rem;
        border-radius: 999px;
        background: var(--orange-color);
        color: var(--background-color);
        font-size: 1.6rem;
        transform: translateY(-250%);
        transition: transform 0.2s ease;
    }
    .skip-link:focus-visible {
        transform: translateY(0);
    }
    header {
        position: fixed;
        display: flex;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        margin: 0 auto;
        justify-content: space-between;
        align-items: center;
        padding: 2rem;
        max-width: var(--max-container-width);
        transition: var(--transition);
        z-index: 999;

        @media only screen and (min-width: 960px) {
            padding: 1.8rem 2.5rem;
        }
    }
    header::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        margin-left: -100vh;
        margin-right: -100vh;
        height: 100%;
        background: linear-gradient(
            rgba(26, 26, 26, 0.4) 60%,
            rgba(0, 0, 0, 0)
        );
        z-index: -1;

        @media only screen and (min-width: 768px) {
            width: 200vw;
        }
    }
    #links {
        display: none;

        @media only screen and (min-width: 768px) {
            display: flex;
            gap: 3rem;
        }
    }
    #links li {
        position: relative;
        overflow-x: hidden;
    }
    #links li::after {
        position: absolute;
        content: "";
        height: 1px;
        bottom: 0px;
        left: 0;
        width: 100%;
        transition: 0.3s ease;

        @media only screen and (max-width: 768px) {
            display: none;
        }
    }
    #links li:hover::after {
        background: var(--white-color);
    }
    :global(#contact-button) {
        display: none;

        @media only screen and (min-width: 768px) {
            display: block;
        }
    }
    #navigation.is-open {
        position: absolute;
        inset: 0;
        display: grid;
        justify-content: start;
        align-items: center;
        background: rgba(26, 26, 26, 0.9);
        width: 100vw;
        height: 100vh;
    }
    #navigation.is-open #links {
        display: flex;
        gap: 3rem;
        flex-direction: column;
        padding: 3rem;
    }
    #navigation.is-open #links li {
        font-size: 2rem;
        font-weight: 500;
        color: var(--color-white);
    }
    #navigation li:last-of-type {
        display: block;
        @media only screen and (min-width: 768px) {
            display: none;
        }
    }
    #hamburger {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        margin: 2rem;
        overflow: hidden;
        cursor: pointer;
        z-index: 999;

        @media only screen and (min-width: 768px) {
            display: none;
        }
    }
    #hamburger span {
        display: block;
        width: 3rem;
        height: 0.2rem;
        background: var(--white-color);
        margin: 0.3rem 0;
        transform-origin: center;
        transition: var(--transition);
    }
    #hamburger.is-open span:nth-of-type(1) {
        transform: rotate(45deg) translateY(8px) scale(1.2);
    }
    #hamburger.is-open span:nth-of-type(2) {
        transform: translateX(200%);
    }
    #hamburger.is-open span:nth-of-type(3) {
        transform: rotate(-45deg) translateY(-8px) scale(1.2);
    }
</style>
