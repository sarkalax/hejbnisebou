---
import Button from "./Button.astro"
import Logo from "./Logo.astro"
---

<header>
    <Logo />
    <nav id="navigation" aria-label="Hlavní">
        <ul id="links">
            <li>
                <a href="#o-mne">Jak začneme</a>
            </li>
            <li>
                <a href="#cenik">Ceník</a>
            </li>
            <li>
                <a href="#reference">Reference</a>
            </li>
            <li>
                <a href="#poukaz">Dárkové poukazy</a>
            </li>
            <li>
                <Button href="#kontaktuj-me" title="Kontakt" />
            </li>
        </ul>
        <button
            id="hamburger"
            type="button"
            aria-label="Otevřít menu"
            aria-expanded="false"
            aria-controls="links"
        >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
    </nav>
    <Button href="#kontaktuj-me" title="Kontaktuj mě" id="contact-button" />
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const body = document.body
        const navigation = document.getElementById("navigation")
        const hamburger = document.getElementById("hamburger")
        const links = document.querySelectorAll("#links a")

        if (!hamburger || !navigation) {
            return
        }

        // Stav menu drzi jedna funkce, aby se aria-expanded nikdy nerozesla
        // s vizualnim stavem.
        const setMenu = (open: boolean) => {
            hamburger.classList.toggle("is-open", open)
            navigation.classList.toggle("is-open", open)
            hamburger.setAttribute("aria-expanded", String(open))
            hamburger.setAttribute(
                "aria-label",
                open ? "Zavřít menu" : "Otevřít menu",
            )
            body.style.overflowY = open ? "hidden" : "auto"
            body.style.height = open ? "100vh" : ""
        }

        window.addEventListener("resize", () => {
            if (window.innerWidth > 768) {
                setMenu(false)
            }
        })

        hamburger.addEventListener("click", () => {
            setMenu(!navigation.classList.contains("is-open"))
        })

        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                navigation.classList.contains("is-open")
            ) {
                setMenu(false)
                hamburger.focus()
            }
        })

        links.forEach((link) => {
            link.addEventListener("click", () => {
                setMenu(false)
            })
        })
    })
</script>

<style>
    .skip-link {
        position: absolute;
        top: 1rem;
        left: 1rem;
        z-index: 1000;
        padding: 1rem 1.5rem;
        border-radius: 14px;
        background: var(--orange-color);
        color: var(--background-color);
        font-size: 1.6rem;
        transform: translateY(-250%);
        transition: transform 0.2s ease;
    }
    .skip-link:focus-visible {
        transform: translateY(0);
    }
    header {
        position: fixed;
        display: flex;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        margin: 0 auto;
        justify-content: space-between;
        align-items: center;
        /* Stejne postranni odsazeni jako Wrapper, aby logo a tlacitko
           lezely na stejne ose x jako texty v sekcich. */
        padding: 2.4rem 2rem;
        max-width: var(--max-container-width);
        transition: var(--transition);
        z-index: 999;

        @media only screen and (min-width: 960px) {
            padding: 2.4rem 2.5rem;
        }
    }
    /* Plovouci "pilulka" - polopruhledne rozmazane pozadi se zaoblenim */
    header::before {
        content: "";
        position: absolute;
        /* Pilulka presahuje za osu textu - obsah uvnitr ma odsazeni 1.2rem */
        inset: 1.4rem 0.8rem;
        border-radius: 14px;
        background: rgba(52, 52, 52, 0.72);
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        backdrop-filter: blur(16px) saturate(140%);
        z-index: -1;

        @media only screen and (min-width: 960px) {
            inset: 1.4rem 0.9rem;
        }
    }
    /* Mensi logo, aby se vesel do pilulky */
    header :global(.logo svg) {
        width: auto;
        height: 3.6rem;
    }
    header :global(.logo span) {
        font-size: 1.5rem;
        line-height: 1.5rem;
        max-width: 5rem;
    }
    #links {
        display: none;

        @media only screen and (min-width: 768px) {
            display: flex;
            gap: 3rem;
        }
    }
    #links li {
        position: relative;
        overflow-x: hidden;
    }
    /* Podtrzeni ma stejnou animaci jako odkaz @hejbnisebou: cara je
       siroka 300 % a vzorek bila / pruhledna / bila se posouva doleva.
       V klidu je viditelny jen prostredni pruhledny dil, po najeti vjede
       cara zprava - stejnym smerem jako u @hejbnisebou. */
    @media only screen and (min-width: 768px) {
        #links li:not(:last-of-type) a {
            position: relative;
            display: block;
            overflow: hidden;
        }
        #links li:not(:last-of-type) a::after {
            position: absolute;
            content: "";
            height: 1px;
            bottom: 0;
            left: -100%;
            width: 300%;
            background: linear-gradient(
                90deg,
                var(--white-color) 33.33%,
                transparent 33.33%,
                transparent 66.66%,
                var(--white-color) 66.66%
            );
            transition: 0.8s ease;
        }
        #links li:not(:last-of-type) a:hover::after {
            left: -200%;
        }
    }
    /* Prepina se jen viditelnost - display: block by prebil .btn { display: flex }
       z komponenty Button (id ma vyssi specificitu nez trida). */
    /* Mensi tlacitko ma mensi odsazeni, sipka se proto posune blize k okraji */
    :global(#contact-button .arrow) {
        right: 0.6rem;
    }
    :global(#contact-button) {
        padding: 1rem 1.8rem;
        display: none;

        @media only screen and (min-width: 768px) {
            display: flex;
        }
    }
    #navigation.is-open {
        position: absolute;
        inset: 0;
        display: grid;
        justify-content: start;
        align-items: center;
        background: rgba(26, 26, 26, 0.9);
        width: 100vw;
        height: 100vh;
    }
    #navigation.is-open #links {
        display: flex;
        gap: 3rem;
        flex-direction: column;
        padding: 3rem 2rem;
    }
    #navigation.is-open #links li {
        font-size: 2rem;
        font-weight: 500;
        color: var(--color-white);
    }
    #navigation li:last-of-type {
        display: block;
        @media only screen and (min-width: 768px) {
            display: none;
        }
    }
    #hamburger {
        position: absolute;
        /* Stejna poloha otevreny i zavreny - hlavicka je vysoka 8.4rem
           (logo 3.6rem + odsazeni 2x2.4rem), proto stred v 4.2rem. */
        top: 4.2rem;
        right: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 2.4rem;
        line-height: 0;
        transform: translateY(-50%);
        overflow: hidden;
        cursor: pointer;
        z-index: 999;

        @media only screen and (min-width: 768px) {
            display: none;
        }
    }
    #hamburger span {
        display: block;
        width: 2.4rem;
        height: 0.2rem;
        background: var(--white-color);
        margin: 0.3rem 0;
        transform-origin: center;
        transition: var(--transition);
    }
    /* Posun se nejdriv provede po svisle ose, az potom rotace - jinak se
       carka posouva po nakloneny ose a krizek ujede do strany. Rozestup
       carek je 0.8rem (vyska 0.2rem + okraje 2x0.3rem). */
    #hamburger.is-open span:nth-of-type(1) {
        transform: translateY(0.8rem) rotate(45deg);
    }
    #hamburger.is-open span:nth-of-type(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    #hamburger.is-open span:nth-of-type(3) {
        transform: translateY(-0.8rem) rotate(-45deg);
    }
</style>
