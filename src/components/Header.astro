---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
---

<header>
    <Logo />
    <nav id="navigation">
        <ul id="links">
            <li>
                <a href="#o-mne">o mně</a>
            </li>
            <li>
                <a href="#co-nabizim">služby</a>
            </li>
            <li>
                <a href="#fitness-kemp">fitness kemp</a>
            </li>
            <li>
                <a href="#cenik">dárkové poukazy</a>
            </li>
            <li>
                <a href="#cenik">ceník</a>
            </li>
            <li>
                <a href="#kontaktuj-me">
                    <Button title="Kontakt" />
                </a>
            </li>
        </ul>
        <div id="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </nav>
    <a id="contact-button" href="#kontaktujte-me">
        <Button title="Kontakt" />
    </a>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const body = document.body;
        const header = document.querySelector("header");
        const navigation = document.getElementById("navigation");
        const hamburger = document.getElementById("hamburger");
        const links = document.querySelectorAll("#links a");

        if (!header || !hamburger || !navigation) {
            return;
        }

        let lastScroll = window.scrollY;
        window.addEventListener("scroll", () => {
            const currentScroll = window.scrollY;

            if (window.innerWidth > 768) {
                if (currentScroll < lastScroll || currentScroll === 0) {
                    header.style.transform = "translateY(0)";
                } else if (currentScroll > lastScroll) {
                    header.style.transform = "translateY(-100%)";
                }
            } else {
                header.style.transform = "translateY(0)";
            }
            lastScroll = currentScroll;
        });

        window.addEventListener("resize", () => {
            if (window.innerWidth > 768) {
                navigation.classList.remove("is-open");
                body.style.overflowY = "auto";
            }
        });

        hamburger.addEventListener("click", () => {
            hamburger.classList.toggle("is-open");
            navigation.classList.toggle("is-open");

            if (navigation.classList.contains("is-open")) {
                body.style.height = "100vh";
                body.style.overflowY = "hidden";
            } else {
                body.style.overflowY = "auto";
            }
        });
        links.forEach((link) => {
            link.addEventListener("click", () => {
                hamburger.classList.remove("is-open");
                navigation.classList.remove("is-open");
                document.body.style.overflowY = "auto";
            });
        });
    });
</script>

<style>
    header {
        position: fixed;
        display: flex;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        margin: 0 auto;
        justify-content: space-between;
        align-items: center;
        padding: 2rem;
        max-width: var(--max-container-width);
        transition: var(--transition);
        z-index: 999;

        @media only screen and (min-width: 960px) {
            padding: 1.8rem 2.5rem;
        }
    }
    header::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        margin-left: -100vh;
        margin-right: -100vh;
        height: 100%;
        background: linear-gradient(
            rgba(26, 26, 26, 0.4) 60%,
            rgba(0, 0, 0, 0)
        );
        z-index: -1;

        @media only screen and (min-width: 768px) {
            width: 200vw;
        }
    }
    #links {
        display: none;

        @media only screen and (min-width: 768px) {
            display: flex;
            gap: 3rem;
        }
    }
    #links li {
        position: relative;
        overflow-x: hidden;
    }
    #links li::after {
        position: absolute;
        content: "";
        height: 1px;
        bottom: 0px;
        left: 0;
        width: 100%;
        transition: 0.3s ease;

        @media only screen and (max-width: 768px) {
            display: none;
        }
    }
    #links li:hover::after {
        background: var(--white-color);
    }
    #contact-button {
        display: none;

        @media only screen and (min-width: 768px) {
            display: block;
        }
    }
    #navigation.is-open {
        position: absolute;
        inset: 0;
        display: grid;
        justify-content: start;
        align-items: center;
        background: rgba(26, 26, 26, 0.9);
        width: 100vw;
        height: 100vh;
    }
    #navigation.is-open #links {
        display: flex;
        gap: 3rem;
        flex-direction: column;
        padding: 3rem;
    }
    #navigation.is-open #links li {
        font-size: 2rem;
        font-weight: 500;
        color: var(--color-white);
    }
    #navigation li:last-of-type {
        display: block;
        @media only screen and (min-width: 768px) {
            display: none;
        }
    }
    #hamburger {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        margin: 2rem;
        overflow: hidden;
        cursor: pointer;
        z-index: 999;

        @media only screen and (min-width: 768px) {
            display: none;
        }
    }
    #hamburger span {
        display: block;
        width: 3rem;
        height: 0.2rem;
        background: var(--white-color);
        margin: 0.3rem 0;
        transform-origin: center;
        transition: var(--transition);
    }
    #hamburger.is-open span:nth-of-type(1) {
        transform: rotate(45deg) translateY(8px) scale(1.2);
    }
    #hamburger.is-open span:nth-of-type(2) {
        transform: translateX(200%);
    }
    #hamburger.is-open span:nth-of-type(3) {
        transform: rotate(-45deg) translateY(-8px) scale(1.2);
    }
</style>
