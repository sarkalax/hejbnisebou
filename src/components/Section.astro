---
import Wrapper from "./Wrapper.astro";

interface Props {
    title: string;
    perex?: string;
}

const { title, perex } = Astro.props;

const id = title
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s/g, "-");
---

<Wrapper id={id}>
    <div>
        <h2 class="section-heading">
            {title}
        </h2>
        <p set:html={perex} class="perex" />
    </div>
    <slot />
</Wrapper>

<style>
    div {
        padding: 6rem 0 4rem;
        width: 100%;
    }
    h2 {
        text-align: center;
    }
    .perex {
        text-align: center;
        font-size: 1.8rem;
        line-height: 1.5;
        color: var(--text-color);
        max-width: 80vw;
        margin: 0 auto;
    }
</style>
