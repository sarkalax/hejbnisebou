---
import Wrapper from "./Wrapper.astro";

interface Props {
    title: string;
    perex?: string;
}

const { title, perex } = Astro.props;

const id = title
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s/g, "-");
---

<section id={id}>
    <Wrapper>
        <h2>
            {title}
        </h2>
        <p>
            {perex}
        </p>
        <slot />
    </Wrapper>
</section>

<style>
    section {
        padding: 6rem 0;
    }
    h2 {
        text-align: center;
        text-transform: uppercase;
    }
</style>
