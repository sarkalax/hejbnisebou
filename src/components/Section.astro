---
import Wrapper from "./Wrapper.astro";

interface Props {
    title: string;
    perex?: string;
}

const { title, perex } = Astro.props;

const id = title
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s/g, "-");
---

<Wrapper id={id}>
    <div>
        <h2 class="section-heading">
            {title}
        </h2>
        {perex && <p set:html={perex} class="perex" />}
        <slot />
    </div>
</Wrapper>

<style>
    div {
        padding-bottom: 5rem;
        width: 100%;

        @media only screen and (min-width: 960px) {
            padding: 8rem 0 5rem;
        }
    }
    h2 {
        text-align: center;
    }
    .perex {
        text-align: center;
        font-size: 1.8rem;
        line-height: 1.5;
        color: var(--text-color);
        padding-bottom: 4rem;
        max-width: 80vw;
        margin: 0 auto;
    }
</style>
