---
import Wrapper from "./Wrapper.astro";

interface Props {
    title?: string;
    /** Vlastni kotva, jinak se odvodi z nadpisu. */
    id?: string;
    eyebrow?: string;
    perex?: string;
}

const { title, eyebrow, perex, id: customId } = Astro.props;

// Sekce bez nadpisu (galerie) drive generovala prazdny <h2> a prazdne id.
const id = customId ?? (title
    ? title
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim()
          .replace(/\s+/g, "-")
    : undefined);
---

<Wrapper id={id}>
    <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 class="section-title">{title}</h2>}
        {perex && <p set:html={perex} class="section-perex" />}
        <slot />
    </div>
</Wrapper>

<style>
    div {
        padding-top: 4rem;
        padding-bottom: 5rem;
        width: 100%;

        @media only screen and (min-width: 960px) {
            padding: 8rem 0 5rem;
        }
    }
</style>
