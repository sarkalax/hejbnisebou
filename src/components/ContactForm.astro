---
import Button from "./Button.astro";
---

<form method="post" id="contact-form" autocomplete="off">
    <label
        >Jméno*
        <input type="text" name="name" placeholder="Jméno" required />
        <p class="error-message" id="name-error"></p>
    </label>
    <label
        >E-mail*
        <input type="email" name="email" id="email" placeholder="E-mail" />
        <p class="error-message" id="email-error"></p>
    </label>
    <label
        >Zpráva*
        <textarea placeholder="Vaše zpráva" name="message" rows="10" required
        ></textarea>
        <p class="error-message" id="message-error"></p>
    </label>
    <Button title="Odeslat" type="submit" />
</form>

<script>
    import { isInputError, actions } from "astro:actions";

    const form = document.getElementById("contact-form") as HTMLFormElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const { data, error } = await actions.contactForm(formData);

        document.querySelectorAll(".error-message").forEach((errorElement) => {
            errorElement.textContent = "";
        });
        const name = document.getElementById("name-error");
        const email = document.getElementById("email-error");
        const message = document.getElementById("message-error");

        if (data) {
            form.reset();
        }
        console.log({ error });

        if (error && isInputError(error)) {
            if (error.fields.name) {
                name.textContent = "Toto pole je povinné";
            }
            if (error.fields.email) {
                email.textContent = "Toto pole je povinné";
            }
            if (error.fields.message) {
                message.textContent = "Toto pole je povinné";
            }
        }
    });
</script>

<style>
    form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    label {
        display: flex;
        gap: 0.8rem;
        flex-direction: column;
    }
    input,
    textarea {
        padding: 1rem 1.5rem;
        border: 1px solid var(--white-color);
        border-radius: 20px;
        line-height: 24px;
        background: none;
    }
    input:focus-visible {
        outline-color: var(--orange-color);
    }
    .error-message {
        color: var(--orange-color);
        opacity: 0.7;
        font-size: 1rem;
    }
</style>
