---
interface Props {
    title: string
    variant?: "primary" | "secondary"
    type?: "button" | "submit"
    /** Kdyz je vyplneny, komponenta se vykresli jako <a>, jinak jako <button>. */
    href?: string
    /** Nove okno. Bez zadani se otevre v novem okne kazdy odkaz ven (http/https). */
    newTab?: boolean
    id?: string
}

const {
    title,
    variant = "primary",
    type = "button",
    href,
    newTab,
    id,
} = Astro.props

const Tag = href ? "a" : "button"
// Odkazy ven (http/https) se otevrou v novem okne
const external = Boolean(href && /^https?:\/\//.test(href))
const opensInNewTab = newTab ?? external
const tagProps = href
    ? opensInNewTab
        ? { href, target: "_blank", rel: "noopener noreferrer" }
        : { href }
    : { type }
---

<Tag class:list={["btn", variant]} id={id} {...tagProps}>
    <span>{title}</span>
</Tag>

<style>
    .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        letter-spacing: 0.01em;
        line-height: 1.2;
        cursor: pointer;
        text-wrap: nowrap;
        transition: var(--transition);
        width: max-content;
    }
    .primary {
        background-color: var(--orange-color);
        border-radius: 8px;
        padding: 1.2rem 2.4rem;
        color: var(--background-color);
    }
    .primary:hover {
        background-color: #e69900;
    }
    .secondary {
        color: var(--white-color);
        font-size: 2rem;
        line-height: 2rem;
    }
    .secondary span {
        position: relative;
        overflow: hidden;
    }
    .secondary span::after {
        position: absolute;
        content: "";
        height: 1px;
        bottom: 0px;
        left: 0;
        width: 300%;
        background: linear-gradient(
            90deg,
            var(--white-color) 33.33%,
            transparent 33.33%,
            transparent 66.66%,
            var(--white-color) 66.66%
        );
        transition: 0.8s ease;
    }
    .secondary:hover span::after {
        @media only screen and (min-width: 768px) {
            left: -200%;
        }
    }
</style>
