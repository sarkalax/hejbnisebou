---
interface Props {
    title: string;
    variant?: "primary" | "secondary";
    type?: "button" | "submit";
}

const { title, variant = "primary", type = "button" } = Astro.props;
---

<button class={variant} type={type}>
    <svg
        width="14"
        height="14"
        viewBox="0 0 18 18"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            d="M18 1.93846L4.70769 15.2308H16.6154V18H0V1.38462H2.76923V13.2923L16.0615 0L18 1.93846Z"
            fill="currentColor"></path>
    </svg>
    <span>
        {title}
    </span>
</button>

<style>
    button {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        gap: 10px;
        text-transform: uppercase;
        font-weight: 500;
        line-height: 1;
        cursor: pointer;
        text-wrap: nowrap;
        transition: var(--transition);
        overflow: hidden;
        width: max-content;
    }
    .primary {
        border: 1px solid var(--background-color);
        background-color: var(--orange-color);
        border-radius: 999px;
        padding: 10px 16px;
        color: var(--background-color);
    }
    .primary:hover {
        background-color: var(--background-color);
        color: var(--orange-color);
        border-color: var(--orange-color);
    }
    .secondary {
        color: var(--white-color);
        font-size: 2rem;
        line-height: 2rem;
    }
    .secondary span {
        position: relative;
        overflow-x: hidden;
    }
    .secondary span::after {
        position: absolute;
        content: "";
        height: 1px;
        bottom: 0px;
        left: 0;
        width: 300%;
        background: linear-gradient(
            90deg,
            var(--white-color) 33.33%,
            transparent 33.33%,
            transparent 66.66%,
            var(--white-color) 66.66%
        );
        transition: 0.8s ease;
    }
    .secondary:hover span::after {
        @media only screen and (min-width: 768px) {
            left: -200%;
        }
    }
</style>
