---
interface Props {
    /** Maly popisek pod nazvem (napr. "Trenuj v soukromi"). */
    kicker?: string
    title: string
    /** Cena v Kc jako cislo, formatuje se az tady. */
    price: number
    priceUnit?: string
    features?: string[]
    /** Plna oranzova karta misto svetle. */
    featured?: boolean
}

const {
    kicker,
    title,
    price,
    priceUnit,
    features = [],
    featured = false,
} = Astro.props

const format = (value: number) =>
    `${Math.round(value).toLocaleString("cs-CZ")} Kč`
---

<div class="wrap">
    <article class:list={{ featured }}>
        <header>
            {kicker && <p class="kicker">{kicker}</p>}
            <h3 class="title">{title}</h3>
        </header>

        <div class="perex"><slot /></div>

        {
            features.length > 0 && (
                <ul class="features">
                    {features.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            )
        }

        <footer>
            <p class="price">
                {format(price)}
                {priceUnit && <span class="price-unit">{priceUnit}</span>}
            </p>
        </footer>
    </article>
</div>

<style>
    .wrap {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
        height: 100%;
    }
    article {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 1.6rem;
        padding: 3rem 2.8rem 2.8rem;
        border-radius: 20px;
        background: var(--card-bg);
        color: var(--card-muted);

        --card-bg: #2b2b2b;
        --card-fg: #ffffff;
        --card-muted: #cacaca;
        --dot: var(--orange-color);

        @media only screen and (min-width: 960px) {
            min-height: 40rem;
        }
    }
    .featured {
        --card-bg: var(--orange-color);
        --card-fg: #1a1a1a;
        --card-muted: rgba(26, 26, 26, 0.8);
        --dot: #1a1a1a;
    }
    .title {
        font-family: "Montserrat";
        font-size: clamp(2.6rem, 2.6vw, 3rem);
        font-weight: 600;
        line-height: 1.1;
        color: var(--card-fg);
    }
    .kicker {
        margin-top: 0.6rem;
        font-size: 1.5rem;
    }
    .perex {
        line-height: 1.5;
    }
    .features {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        font-weight: 500;
        color: var(--card-fg);
    }
    .features li {
        display: flex;
        gap: 1rem;
        line-height: 1.3;
    }
    .features li::before {
        content: "";
        flex-shrink: 0;
        margin-top: 0.25em;
        width: 1.2rem;
        height: 1.2rem;
        border-radius: 50%;
        background: var(--dot);
    }
    footer {
        margin-top: auto;
        padding-top: 2.4rem;
    }
    .price {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.8rem;
        font-family: "Montserrat";
        font-size: clamp(3.4rem, 1rem + 3vw, 4.6rem);
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        color: var(--card-fg);
    }
    .price-unit {
        font-family: inherit;
        font-size: 1.6rem;
        font-weight: 500;
        color: var(--card-muted);
    }
</style>
