---
interface Props {
    title: string;
    price: string;
    perex?: string;
    packagePrice?: string;
}

const { title, price, perex, packagePrice } = Astro.props;
---

<article>
    <h3 class="title">{title}</h3>
    <p set:html={perex} />
    <div class="prices">
        <h3 class="price" set:html={price} />
        {price && packagePrice && <div>NEBO</div>}
        {
            packagePrice && (
                <>
                    <h3 set:html={packagePrice} /> / 10 tréninků
                </>
            )
        }
    </div>
</article>

<style>
    article {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        position: relative;
        box-shadow: 1px -1px 0 rgba(255, 170, 0, 0.4);
        border-radius: 40px;
        width: 300px;
        height: 400px;
        padding: 4.8rem 4rem;
        overflow: hidden;
    }
    article::before {
        position: absolute;
        inset: 0;
        display: block;
        content: "";
        background: radial-gradient(
            circle at top right,
            rgba(255, 170, 0, 1) 0%,
            rgba(214, 126, 21, 0.5) 32%,
            rgba(0, 0, 0, 0) 80%
        );
        opacity: 0.4;
    }
    h3 {
        font-size: clamp(2.4rem, 3vw, 3.2rem);
    }
    .title {
        font-family: "SourceSans";
        font-size: clamp(2rem, 3vw, 2.4rem);
        text-transform: uppercase;
    }
    .prices {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        margin-top: auto;
        gap: 1rem;
    }
</style>
