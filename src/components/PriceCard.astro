---
interface Props {
    title: string;
    price: string;
    packagePrice?: string;
}

const { title, price, packagePrice } = Astro.props;
---

<article>
    <h3>{title}</h3>
    <h4 set:html={price} />
    {
        packagePrice && (
            <>
                NEBO <br />
                <p set:html={packagePrice} />
            </>
        )
    }
</article>

<style>
    article {
        display: flex;
        flex-direction: column;
        gap: 3rem;
        position: relative;
        box-shadow: 1px -1px 0 rgba(255, 170, 0, 0.4);
        border-radius: 40px;
        max-width: 350px;
        width: 100%;
        height: 400px;
        padding: 4.8rem 4rem;
        overflow: hidden;
    }
    article::before {
        position: absolute;
        inset: 0;
        display: block;
        content: "";
        background: radial-gradient(
            circle at top right,
            rgba(255, 170, 0, 1) 0%,
            rgba(214, 126, 21, 0.5) 32%,
            rgba(0, 0, 0, 0) 80%
        );
        opacity: 0.4;
    }
    h3 {
        font-family: "SourceSans";
        font-size: clamp(2.4rem, 3vw, 2.8rem);
    }
    h4 {
        font-size: clamp(2.4rem, 3vw, 3.2rem);
    }
</style>
