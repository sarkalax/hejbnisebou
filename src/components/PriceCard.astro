---
interface Props {
    title: string
    price?: string
    priceUnit?: string
    packagePrice?: string
    packageNumber?: number
}

const {
    title,
    price,
    priceUnit,
    packagePrice,
    packageNumber = 10,
} = Astro.props
---

<article>
    <h3 class="title" set:html={title} />
    <div class="perex"><slot /></div>
    <div class="prices">
        {
            price && (
                <div>
                    <h3 class="price" set:html={price} /> {priceUnit}
                </div>
            )
        }
        {price && packagePrice && <div>NEBO</div>}
        {
            packagePrice && (
                <div>
                    <h3 set:html={packagePrice} /> / {packageNumber} tréninků
                </div>
            )
        }
    </div>
</article>

<style>
    article {
        display: flex;
        flex-direction: column;
        position: relative;
        justify-content: flex-start;
        container-type: inline-size;
        gap: 2rem;
        box-shadow: 1px -1px 0 rgba(255, 170, 0, 0.4);
        border-radius: 40px;
        width: 100%;
        height: 100%;
        padding: 4.8rem 4rem;
        overflow: hidden;
    }
    article::before {
        position: absolute;
        inset: 0;
        display: block;
        content: "";
        background: radial-gradient(
            circle at top right,
            rgba(255, 170, 0, 1) 0%,
            rgba(214, 126, 21, 0.5) 32%,
            rgba(0, 0, 0, 0) 80%
        );
        opacity: 0.4;
        pointer-events: none;
        z-index: 0;
    }
    article > * {
        position: relative;
        z-index: 1;
    }
    h3 {
        font-size: clamp(2.4rem, 3vw, 3.2rem);
        display: inline-block;
    }
    .title {
        font-family: "SourceSans";
        font-size: clamp(2rem, 3vw, 2.4rem);
        text-transform: uppercase;
    }
    .prices {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        margin-top: auto;
        padding-top: 2rem;
        white-space: nowrap;
    }

    .prices h3 {
        font-size: clamp(2.4rem, 1rem + 3.5vw, 3.2rem);
    }
    .perex {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .perex :global(li)::before {
        content: "• ";
    }
    .perex :global(ul ul) {
        padding-left: 1.6rem;
        margin-top: 0.4rem;
    }
    .perex :global(ul ul li)::before {
        content: "– ";
    }
    .perex :global(a) {
        text-decoration: underline;
    }
</style>
