---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Wrapper from "./Wrapper.astro";
import image from "../assets/img/hero.jpg";
---

<div class="hero">
    <Image
        src={image}
        width={1920}
        alt="Osobní trenér Chomutov"
        class="hero-image"
    />
    <div class="gradient"></div>
    <Wrapper>
        <div class="hero-content">
            <h1>BUDUJ SÍLU A&nbsp;SVALY, NE&nbsp;EGO</h1>
            <div class="perex">
                <article>
                    Jmenuju se Kristýna Ivančíková, jsem <span
                        class="highlight-text"
                        >osobní trenér v Chomutově, Jirkově a v Praze</span
                    > a našla jsem smysl v tom, co dělám. Šťourám se v anatomii a
                    naplňuje mě, když někomu pomůžu.
                </article>
                <a href="#muj-pristup">
                    <Button title="Můj přístup" variant="secondary" />
                </a>
            </div>
        </div>
    </Wrapper>
</div>

<style>
    h1 {
        font-size: clamp(3rem, 8vw, 7rem);
        color: var(--orange-color);
        line-height: 7.8rem;
        font-weight: 800;
        padding-bottom: 2rem;
        line-height: 1;
        z-index: 1;

        @media only screen and (min-width: 960px) {
            max-width: 50vw;
        }
    }
    .hero {
        position: relative;
    }
    .hero-content {
        position: absolute;
        font-size: 2rem;
        bottom: 0;
        color: var(--text-color);
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        justify-content: flex-end;
        padding-bottom: clamp(3rem, 10vw, 5rem);
        align-self: flex-end;
    }
    .hero-image {
        height: 100vh;
        width: 100vw;
        object-fit: cover;
        object-position: center;
        user-select: none;
        -webkit-user-select: none;

        @media only screen and (min-width: 960px) {
            object-position: left;
        }
    }
    .perex {
        display: flex;
        flex-direction: column;
        row-gap: 3rem;
        z-index: 1;
        max-width: 80vw;

        @media only screen and (min-width: 960px) {
            flex-direction: row;
            column-gap: 50px;
            max-width: 50vw;
        }
    }
    .gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50vh;
        background: linear-gradient(rgba(0, 0, 0, 0), rgba(26, 26, 26, 1));
        z-index: 1;
    }
</style>
