---
import { Image } from "astro:assets"
import image from "../assets/img/hero.jpg"
import Button from "./Button.astro"
import Wrapper from "./Wrapper.astro"
---

<div class="hero">
    <Image
        src={image}
        width={1920}
        alt="Osobní trenér Chomutov"
        class="hero-image"
        loading="eager"
        sizes="100vw"
        widths={[640, 1280, 1920, 2560]}
    />
    <div class="gradient"></div>
    <Wrapper>
        <div class="hero-content">
            <h1>Ukazuju lidem, jak&nbsp;silní můžou být</h1>
            <div class="perex">
                <article>
                    <h3 class="highlight-text">
                        A taky pomáhám zbavit se bolesti
                    </h3>
                    Ahoj, jsem Kristýna! Jsem osobní trenérka v Chomutově a v Praze,
                    trénuju v soukromí bez ruchu veřejného fitka, nebo online odkudkoli.
                </article>
                <p>
                    Chceš si mě trošku víc proklepnout?
                    <Button
                        href="https://www.instagram.com/hejbnisebou"
                        title="@hejbnisebou"
                        variant="secondary"
                    />
                </p>
            </div>
        </div>
    </Wrapper>
</div>

<style>
    h1 {
        font-size: clamp(3rem, 8vw, 7rem);
        color: var(--orange-color);
        line-height: 7.8rem;
        font-weight: 800;
        padding-bottom: 2rem;
        line-height: 1;
        z-index: 1;

        @media only screen and (min-width: 960px) {
            max-width: 50vw;
        }
    }
    article {
        color: #dadada;
    }
    .hero {
        position: relative;
    }
    .hero-content {
        position: absolute;
        font-size: 2rem;
        left: 0;
        padding-inline: 2rem;
        bottom: 0;
        color: var(--text-color);
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        justify-content: flex-end;
        padding-bottom: clamp(3rem, 10vw, 5rem);
        align-self: flex-end;

        @media only screen and (min-width: 960px) {
            padding-inline: 2.5rem;
        }
    }
    .hero-image {
        height: 100vh;
        width: 100vw;
        object-fit: cover;
        object-position: center;
        user-select: none;
        -webkit-user-select: none;

        @media only screen and (min-width: 960px) {
            object-position: left;
        }
    }
    .perex {
        display: flex;
        flex-direction: column;
        row-gap: 3rem;
        z-index: 1;
        max-width: 80vw;
        align-items: start;

        .highlight-text {
            padding-bottom: 1rem;
        }

        /* Mezera mezi otazkou a odkazem na Instagram */
        p :global(.btn) {
            margin-top: 1rem;
        }

        @media only screen and (min-width: 960px) {
            flex-direction: row;
            column-gap: 50px;
            article {
                max-width: 40vw;
            }
        }
    }
    .gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50vh;
        background: linear-gradient(
            rgba(0, 0, 0, 0) 10%,
            rgba(26, 26, 26, 0.9) 40%,
            rgba(26, 26, 26, 1) 100%
        );
        z-index: 1;

        @media only screen and (max-width: 400px) {
            background: linear-gradient(
                rgba(0, 0, 0, 0) 0%,
                rgba(26, 26, 26, 0.4) 25%,
                rgba(26, 26, 26, 0.7) 50%,
                rgba(26, 26, 26, 0.9) 75%,
                rgba(26, 26, 26, 1) 100%
            );
            height: 70vh;
        }
    }
</style>
