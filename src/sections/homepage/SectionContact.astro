---
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<Section title="Kontaktuj mě">
    <div class="wrapper">
        <!-- <ContactForm /> -->
        <p>
            Máš nějaké dotazy? Sem s nimi! <br /><a
                href="tel:+420 777 777 777"
                class="highlight-orange-text"
            >
                +420 777 777 777
            </a><br /> nebo na <br />
            <a href="mailto:hejbnisebou@gmail.com" class="highlight-orange-text"
                >hejbnisebou@gmail.com</a
            >
        </p>
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2722.137317260941!2d13.404631012132922!3d50.45561878687319!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470a1baa4f4b39b3%3A0xe7493713ac42a0f8!2sHejbni%20sebou!5e1!3m2!1scs!2scz!4v1736602417460!5m2!1scs!2scz"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</Section>

<style>
    .wrapper {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;

        @media only screen and (min-width: 960px) {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    iframe {
        width: 100%;
        aspect-ratio: 16 / 9;
    }
    p {
        padding: 4rem;
        padding-left: 0;
    }
</style>
