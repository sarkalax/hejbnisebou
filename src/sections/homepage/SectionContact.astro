---
import Section from "../../components/Section.astro"
---

<Section
    title="Kontaktuj mě"
    perex="Není ti něco jasné? Máš nějaké dotazy? Sem s nimi!"
>
    <p>
        Kontaktovat mě můžeš na: <br /><a
            href={`tel:${import.meta.env.CONTACT_PHONE}`}
            class="highlight-orange-text"
        >
            +420 733 220 702
        </a><br /> nebo přes <br />
        <a
            href={`mailto:${import.meta.env.CONTACT_EMAIL}`}
            class="highlight-orange-text">hejbnisebou@gmail.com</a
        >
    </p>
</Section>

<style>
    .wrapper {
        display: grid;
        align-items: center;
        grid-template-columns: 1fr;
        gap: 4rem;

        @media only screen and (min-width: 960px) {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    p {
        text-align: center;
    }
</style>
