---
import { Tab, TabItem } from "free-astro-components"
import Section from "../../components/Section.astro"

import kid from "../../assets/svg/kid.svg"
import glass from "../../assets/svg/magnifying-glass.svg"
import muscle from "../../assets/svg/muscle.svg"
import pain from "../../assets/svg/pain.svg"
import run from "../../assets/svg/run.svg"
import shrimp from "../../assets/svg/shrimp.svg"
import OfferCard from "../../components/OfferCard.astro"

const items = [
    {
        icon: glass,
        title: "Diagnostika",
        category: "individual",
    },
    {
        icon: muscle,
        title: "Budování síly a kondice",
        category: "individual",
    },
    {
        icon: pain,
        title: "Eliminace bolesti",
        category: "individual",
    },
    {
        icon: shrimp,
        title: "Zdravá záda/corporate shrimp",
        category: "skupinovky",
    },
    {
        icon: muscle,
        title: "Síla a kondice",
        category: "skupinovky",
    },
    {
        icon: run,
        title: "Zdravé kyčle a kolena",
        category: "skupinovky",
    },
    {
        icon: kid,
        title: "Dětský pohybový kroužek",
        category: "skupinovky",
    },
]

const individual = items.filter((item) => item.category === "individual")
const skupinovky = items.filter((item) => item.category === "skupinovky")
---

<Section
    title="Co nabízím"
    perex=`Nabízím <span class="highlight-text">individuální</span> tréninky šité na míru vašim cílům i <span class="highlight-text">skupinové</span> lekce plné energie, zábavy a motivace. Nabídku můžete vidět níže`
>
    <Tab
        tabs={[{ label: "INDIVIDUAL", active: true }, { label: "SKUPINOVKY" }]}
    >
        <TabItem active
            >{individual.map((item) => <OfferCard {...item} />)}</TabItem
        >
        <TabItem>{skupinovky.map((item) => <OfferCard {...item} />)}</TabItem>
    </Tab>
</Section>
