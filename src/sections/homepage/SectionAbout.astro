---
import { Image } from "astro:assets";

import Button from "../../components/Button.astro";
import Wrapper from "../../components/Wrapper.astro";

import about from "../../assets/img/about.jpg";

const steps = [
    {
        title: "První krok zvládneš i v pyžamu.",
        text: "Vybereš si termín a dáme si 20 minut na nezávazný pokec. Předem ti pošlu krátký dotazník, ať víme, o čem se budeme bavit. Ty mi řekneš, co potřebuješ, já ti povím, jak ti můžu pomoct.",
    },
    {
        title: "Žádný trénink přes kopírák.",
        text: "Na vstupním tréninku poznám tvoje možnosti, silné stránky i omezení. Společně nastavíme způsob tréninku, který bude dávat smysl právě tobě. Dostaneš vlastní plán a přístup do klientské sekce.",
    },
    {
        title: "Teď už žádný „od pondělí“.",
        text: "Začínáme trénovat! Máme domluvené tréninky, každý týden si dáme 20minutový online trénink s korekcí techniky, kde doladíme techniku cviků na doma a já průběžně sleduju tvoje výsledky, monitoruju zátěž a upravuju plán podle toho, jak se posouváš.",
    },
]
const calendarUrl =
    "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0lLEHvoXtZnIo-BMhCINbuWCDknQ0kxlgSf_12b1juJ52gE1AHpN0dPt1p62YW0_kon_SSygRY?gv=true"
---

<Wrapper id="o-mne">
    <div class="about-section">
        <p class="eyebrow">Jak začneme</p>
        <h2 class="section-title">Neboj, nezačneme angličáky</h2>
        <div class="content">
            <div class="start">
                <ol>
                    {
                        steps.map((step, index) => (
                            <li>
                                <span class="num" aria-hidden="true">
                                    <span>
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                </span>
                                <h3>{step.title}</h3>
                                <p>{step.text}</p>
                            </li>
                        ))
                    }
                </ol>
                <p class="cta-text">Tak co, dáme těch prvních 20 minut?</p>
                <Button href={calendarUrl} title="Rezervovat konzultaci" />
            </div>
            <div class="photo">
                <Image
                    src={about}
                    alt="Fyzio fitness osobní trenér Chomutov"
                    width={900}
                />
            </div>
        </div>
    </div>
</Wrapper>

<style>
    .about-section {
        padding-top: 4rem;
        padding-bottom: 5rem;

        @media only screen and (min-width: 960px) {
            padding-top: 8rem;
        }
    }
    .content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;

        @media only screen and (min-width: 960px) {
            grid-template-columns: 3fr 2fr;
            gap: 2rem;
        }
    }
    /* Fotka se natahne na vysku textu vedle ni, takze oba sloupce
       konci ve stejne vysce. */
    .photo {
        position: relative;
        min-height: 33rem;
        overflow: hidden;
        border-radius: 20px;
    }
    .photo :global(img) {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    ol {
        display: flex;
        flex-direction: column;
        list-style: none;
        padding-bottom: 2.4rem;
    }
    /* Velke bile cislo oriznute v polovine vysky */
    li {
        padding: 1rem 0 3rem;
    }
    .num {
        display: block;
        height: 0.65em;
        overflow: hidden;
        font-family: "Montserrat";
        font-size: clamp(9rem, 12vw, 13rem);
        font-weight: 700;
        line-height: 1;
        color: #4a4a4a;
    }
    .num span {
        display: block;
        margin-left: -0.04em;
    }
    h3 {
        padding-top: 1.6rem;
        font-family: "Montserrat";
        font-size: clamp(2.4rem, 2.6vw, 3.2rem);
        font-weight: 300;
        line-height: 1.2;
    }
    li p {
        padding-top: 1.2rem;
        font-size: 1.6rem;
        line-height: 1.55;
        max-width: 80ch;
    }
    .cta-text {
        padding-bottom: 1.6rem;
        font-size: 1.8rem;
        color: var(--white-color);
    }
    .start :global(.btn) {
        text-wrap: wrap;
        text-align: left;
        max-width: 100%;
    }
</style>
