---
import PriceCard from "../../components/PriceCard.astro";
import Section from "../../components/Section.astro";

const items = [
    {
        title: "Individuální trénink",
        price: "600 Kč",
        packagePrice: "5000 Kč",
    },
    {
        title: "Párový trénink",
        price: "800 Kč",
        packagePrice: "7000 Kč",
    },
    {
        title: "Základy cvičení",
        perex: "• naučím tě, jak bezpečně a efektivně cvičit bez trenéra <br/>• technika cviků s váhou, na strojích i s vlastní váhou<br/>• jak si sestavit tréninkový plán, a jak ho upravovat podle potřeb",
        packagePrice: "6000 Kč",
    },
    {
        title: "Skupinovka",
        perex: "Vstup je zahrnut v ceně",
        price: "150 Kč",
    },
    {
        title: "Skupinový workshop",
        perex: "• naučím tě, jak bezpečně a efektivně cvičit bez trenéra <br/>• technika cviků s vlastní váhou<br/>• jak si sestavit tréninkový plán, a&nbsp;jak ho upravovat dle potřeb <br/> • skupina 4-6 klientů",
        packagePrice: "3000 Kč",
    },
    {
        title: "Online trénink",
        packagePrice: "3000 Kč",
    },
];
---

<Section
    title="Ceník"
    perex="<strong class='highlight-text'>PRVNÍ TRÉNINK ZA 200,-kč</strong> (jeden oběd) - ať máte možnost posoudit, jestli za to ty peníze stojí. <br/> Na vše kromě skupinovek nabízím <strong class='highlight-text'>slevu pro samoživitele a seniory</strong>. Vše je o domluvě. <br/><br/> Nabízím také <strong class='highlight-text'>dárkové poukazy</strong> na všechny tréninky a lekce."
>
    <ul>
        {
            items.map((item) => (
                <li>
                    <PriceCard {...item} />
                </li>
            ))
        }
    </ul>
</Section>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6rem;
        justify-content: center;

        @media only screen and (min-width: 600px) {
            column-gap: 3rem;
            row-gap: 2rem;
        }
    }
</style>
