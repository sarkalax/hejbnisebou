---
import PriceCard from "../../components/PriceCard.astro";
import Section from "../../components/Section.astro";

const items = [
    {
        title: "Individual",
        price: "1100 Kč",
        packagePrice: "10000 Kč",
        perex: "<ul><li>• tréninkový plán, průběžná úprava plánu </li><li>• řešení konkrétních problémů klienta, úrazů, apod.</li><li>• online konzultace </li><li>• video návody na kompenzační cviky </li><li>• případná konzultace/ošetření od spřátelených doktorů <br/> • možnost vytvoření jídelníčku od MUDr. Romany Zámečníkové za zvýhodněnou cenu</li></ul>",
    },
    {
        title: "Individual pro dva",
        price: "1200 Kč",
        packagePrice: "11000 Kč",
        perex: "<ul><li>• obsahuje veškeré výhody individuálního tréninku</li><li>• parťákovi a tobě na míru za zvýhodněnou cenu </li><li>• plán okořeněný o zábavné cviky v páru</li></ul>",
    },
    {
        title: "Základy cvičení",
        perex: "<ul><li>• naučím tě, jak bezpečně a efektivně cvičit bez trenéra </li><li>• technika cviků s váhou, na strojích i s vlastní váhou</li><li>• jak si sestavit tréninkový plán, a jak ho upravovat podle potřeb </li><li>• online konzultace mimo trénink</li></ul>",
        packagePrice: "6000 Kč",
    },
    {
        title: "Skupinovka",
        perex: "Vstup je zahrnut v ceně <br/><ul><li>•  fyziofitness - zdravá záda, GOATA (biomechanika), mobilita a kompenzace </li><li>• síla a svaly, hubnutí a kondice, cvičení venku, cvičení s vlastní vahou, švihadlo</li></ul>",
        price: "150 Kč",
    },
    {
        title: "Skupinový workshop",
        perex: "<ul><li>• naučím tě, jak bezpečně a efektivně cvičit bez trenéra </li><li>• technika cviků s vlastní váhou</li><li>• jak si sestavit tréninkový plán, a&nbsp;jak ho upravovat dle potřeb </li><li>• skupina 4-6 klientů</li></ul>",
        packagePrice: "3000 Kč",
    },
    {
        title: "Online trénink",
        packagePrice: "3000 Kč",
        perex: "<ul><li>• video návody na cviky</li> <li>• tréninkový program a jeho průběžná úprava </li><li>• týdenní kontrola techniky a výsledků </li><li>• týdenní konzultace </li><li>• případná konzultace/ošetření od spřátelených doktorů </li><li>• možnost vytvoření jídelníčku od MUDr. Romany Zámečníkové za zvýhodněnou cenu </li></ul>",
    },
];
---

<Section
    title="Ceník"
    perex="<strong class='highlight-text'>PRVNÍ TRÉNINK ZA 200,-kč</strong> (jeden oběd) - ať máte možnost posoudit, jestli za to ty peníze stojí. <br/> Na vše kromě skupinovek nabízím <strong class='highlight-text'>slevu pro samoživitele a seniory</strong>. Vše je o domluvě. <br/><br/> Nabízím také <strong class='highlight-text'>dárkové poukazy</strong> na všechny tréninky a lekce."
>
    <ul>
        {
            items.map((item) => (
                <li>
                    <PriceCard {...item} />
                </li>
            ))
        }
    </ul>
</Section>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6rem;
        justify-content: center;

        @media only screen and (min-width: 600px) {
            column-gap: 3rem;
            row-gap: 2rem;
        }
    }
</style>
